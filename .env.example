# Copy this file to .env and fill in your values for local development.
# .env is gitignored — never commit real keys.
#
# For EAS builds, secrets are stored in the EAS project (eas env:list).
# You only need .env for running the app locally with `npx expo start`.

# Anthropic API key — used client-side for AI features (Coach, food photo analysis, etc.)
# Get yours at https://console.anthropic.com
EXPO_PUBLIC_ANTHROPIC_API_KEY=sk-ant-api03-YOUR_KEY_HERE

# Set to true to bypass the RevenueCat paywall for local/TestFlight testing.
# Must be false for App Store production builds.
EXPO_PUBLIC_IS_TESTFLIGHT=false

# Sentry error reporting. Get from sentry.io -> Settings -> Client Keys.
# Empty or a YOUR_ placeholder disables reporting (see utils/logError.ts).
EXPO_PUBLIC_SENTRY_DSN=
