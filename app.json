{
  "expo": {
    "name": "Fuelog",
    "slug": "macro-log",
    "version": "1.0.0",
    "scheme": "fuelog",
    "orientation": "portrait",
    "userInterfaceStyle": "automatic",
    "icon": "./assets/icon.png",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#08090B"
    },
    "ios": {
      "bundleIdentifier": "com.zackschramm.macrolog",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:fuelog.app"
      ],
      "entitlements": {
        "com.apple.security.application-groups": [
          "group.com.zackschramm.macrolog"
        ]
      },
      "infoPlist": {
        "NSCameraUsageDescription": "Fuelog uses your camera to scan food barcodes and take photos of meals.",
        "NSPhotoLibraryUsageDescription": "Fuelog uses your photo library to attach progress photos and food images.",
        "NSUserNotificationsUsageDescription": "Fuelog sends daily reminders to log your meals, water, and workouts.",
        "NSHealthShareUsageDescription": "Fuelog reads your health data \u2014 including HRV, sleep, steps, heart rate, and workouts \u2014 to personalize your daily fueling targets and race plans.",
        "NSHealthUpdateUsageDescription": "Fuelog writes your weight, nutrition, and workouts to Apple Health.",
        "ITSAppUsesNonExemptEncryption": false,
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "com.zackschramm.macrolog",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#08090B"
      },
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.VIBRATE",
        "android.permission.RECORD_AUDIO"
      ]
    },
    "plugins": [
      [
        "@sentry/react-native/expo",
        {
          "organization": "fuelog-llc",
          "project": "react-native"
        }
      ],
      "expo-image-picker",
      [
        "expo-camera",
        {
          "cameraPermission": "Fuelog uses your camera to scan food barcodes and take photos of meals."
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#121212"
        }
      ],
      "react-native-health",
      [
        "react-native-health-connect",
        {
          "healthConnectPermissions": [
            "HeartRateVariabilityRmssd",
            "RestingHeartRate",
            "HeartRate",
            "SleepSession",
            "Steps",
            "ActiveCaloriesBurned",
            "TotalCaloriesBurned",
            "BasalMetabolicRate",
            "OxygenSaturation",
            "RespiratoryRate",
            "Vo2Max",
            "ExerciseSession"
          ]
        }
      ],
      "./plugins/withWidget",
      "./plugins/withSiriShortcuts",
      "./plugins/withCodeSigningFix",
      "expo-web-browser",
      [
        "expo-build-properties",
        {
          "ios": {
            "deploymentTarget": "15.1"
          },
          "android": {
            "minSdkVersion": 26,
            "compileSdkVersion": 35,
            "targetSdkVersion": 35
          }
        }
      ]
    ],
    "extra": {
      "sentryDsn": "",
      "analyticsEndpoint": "",
      "analyticsKey": "",
      "eas": {
        "projectId": "d47c3758-3b67-47fa-a584-9353dfd02ce0",
        "build": {
          "experimental": {
            "ios": {
              "appExtensions": [
                {
                  "targetName": "FuelogWidget",
                  "bundleIdentifier": "com.zackschramm.macrolog.widget",
                  "entitlements": {
                    "com.apple.security.application-groups": [
                      "group.com.zackschramm.macrolog"
                    ]
                  }
                }
              ]
            }
          }
        }
      }
    },
    "owner": "zackschramm",
    "jsEngine": "hermes",
    "newArchEnabled": false
  }
}
